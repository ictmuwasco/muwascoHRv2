# MUWASCO HR System - Apache Configuration
# Enable URL rewriting and security features

<IfModule mod_rewrite.c>
    RewriteEngine On
    
        # Redirect HTTP to HTTPS (PRODUCTION).
    # Uncomment AFTER TLS is configured. If a load balancer terminates TLS
    # and forwards plain HTTP, enforce HTTPS at the LB/WAF layer instead.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # ---- Block sensitive directories from HTTP access (Phase 7, S-SEC-07) ----
    # These trees hold repository metadata, third-party binaries, CI secrets,
    # dev/ops scripts, or application source that must never be served. The web
    # request path executes ONLY from api.php / index.php (docroot) and
    # backend/public/. All other backend paths are loaded server-side via PHP
    # require (e.g. api.php -> backend/bootstrap.php), so denying HTTP access
    # does NOT affect application logic. 404 (not 403) avoids confirming
    # existence. Handles both bare-root and /hrdemo/ subdirectory layouts.
    RewriteCond %{REQUEST_URI} ^/(hrdemo/)?(\.git|tools|vendor|node_modules|\.github|scripts)/ [NC]
    RewriteRule ^ - [R=404,L]
    RewriteCond %{REQUEST_URI} ^/(hrdemo/)?backend/(?!public/) [NC]
    RewriteRule ^ - [R=404,L]
    RewriteCond %{REQUEST_URI} ^/(hrdemo/)?frontend/src/ [NC]
    RewriteRule ^ - [R=404,L]

    # Pass Authorization header to PHP (needed for JWT token authentication)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # API Routes (handle subdirectory installation)
    RewriteRule ^(hrdemo/)?api/(.*)$ api.php [QSA,L,E=API_ROUTE:1]
    
    # Frontend SPA - Serve index.php for all non-file routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
    
    # Handle query parameter routing (e.g., /hrdemo/?route=employees)
    RewriteCond %{QUERY_STRING} route=
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    
    # HSTS (PRODUCTION). Uncomment only when served exclusively over HTTPS.
    # SecurityMiddleware::secureCryptoHeaders() already emits HSTS on HTTPS
    # requests; this block covers plain-HTTP requests that receive no HSTS
    # header from PHP.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Disable directory browsing
Options -Indexes

# Service worker, manifest and the SPA shell must never be served stale.
#
# These are the three files whose CONTENT names the current build (index.html
# references the hashed bundle; sw.js/ the manifest control push registration).
# A cached copy pins the browser to an old bundle or breaks push, so they are
# revalidated on every load. Vite's fingerprinted /assets files are the
# exception and get a one-year immutable lifetime from
# backend/public/assets/.htaccess.
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Protect sensitive files
<FilesMatch "\.(env|log|sql|md|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock|\.env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Deny source, config and script-injection file types at the extension level.
    # These are never served at runtime (TypeScript source is transpiled by Vite;
    # YAML/INI/SH/BAT are ops files). Catches the standalone copy
    # .deploy-workflow.yml and any stray baseline dumps in the docroot root.
    <FilesMatch "\.(ya?ml|sh|bat|ps1|ini|toml|ts|tsx|jsx|bak|backup|orig|swp|save)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Deny from all
        </IfModule>
    </FilesMatch>

    # Sensitive directories and source trees (.git/, vendor/, backend/ except
    # backend/public/, scripts/, tools/, frontend/src/) are denied above by
    # RewriteRule. The backend application is reached only server-side through
    # api.php / backend/public/index.php.

# PHP settings
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# Gzip compression
#
# HTML/CSS/JS/JSON are the bulk of every page load, and the SPA bundle is
# image-free text (~660 KB uncompressed), so compression is the single biggest
# transfer win after immutable caching. woff2 is deliberately NOT compressed:
# it is already a compressed container (deflate would waste CPU for ~0 gain).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
    AddOutputFilterByType DEFLATE application/rss+xml application/ld+json

    # Never let a proxy serve a gzipped body to a client that cannot read it.
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>

# Cache control for static assets.
#
# Files under /assets are fingerprinted by the Vite build and receive a
# one-year `immutable` lifetime from backend/public/assets/.htaccess. The rules
# below cover everything else: uploaded documents, profile images, icons and
# fonts, whose names are stable and whose content can therefore CHANGE.
# They are given a moderate lifetime plus revalidation rather than `immutable`.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 day"
    # The SPA shell and the service worker must always be revalidated - see the
    # no-cache FilesMatch below, which intentionally wins over this block.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>