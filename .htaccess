# MUWASCO HR System - Apache Configuration
# Enable URL rewriting and security features

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect HTTP to HTTPS (PRODUCTION).
    # Uncomment AFTER TLS is configured. If a load balancer terminates TLS
    # and forwards plain HTTP, enforce HTTPS at the LB/WAF layer instead.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    
    # Pass Authorization header to PHP (needed for JWT token authentication)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # API Routes (handle subdirectory installation)
    RewriteRule ^(hrdemo/)?api/(.*)$ api.php [QSA,L,E=API_ROUTE:1]
    
    # Frontend SPA - Serve index.php for all non-file routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
    
    # Handle query parameter routing (e.g., /hrdemo/?route=employees)
    RewriteCond %{QUERY_STRING} route=
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    
    # HSTS (PRODUCTION). Uncomment only when served exclusively over HTTPS.
    # SecurityMiddleware::secureCryptoHeaders() already emits HSTS on HTTPS
    # requests; this block covers plain-HTTP requests that receive no HSTS
    # header from PHP.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Disable directory browsing
Options -Indexes

# Service worker + manifest must never be served stale - browsers cache
# them aggressively and a poisoned copy breaks push registration.
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Protect sensitive files
<FilesMatch "\.(env|log|sql|md|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock|\.env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Note: Backend directory access is controlled by application routing
# The backend contains controllers and views that are accessed through index.php

# PHP settings
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache control for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>