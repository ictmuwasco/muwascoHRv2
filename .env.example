# =============================================================================
# TEMPLATE ONLY - NAMES AND DEFAULTS, NEVER REAL SECRETS.
#
# Every credential below ships EMPTY on purpose. A real value in this file is a
# security incident: this file is git-TRACKED, so anything written here lands in
# git history and on GitHub forever.
#
#   Local      -> copy to `.env` and fill in; `.env` is gitignored.
#   Production -> do NOT ship a `.env`. Supply these via Plesk / PHP-FPM env
#                 vars; bootstrap.php only loads `.env` when the file exists.
#
# The blocking CI gate `php scripts/ci/secret_scan.php` fails the build on any
# value in this file, but the gate is a backstop, not a licence to paste keys.
# Generate secrets with:  php -r "echo bin2hex(random_bytes(32));"
# =============================================================================
# Application Configuration
APP_NAME="MUWASCO HR System"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/hrdemo

# Frontend API Configuration (used by .tsx pages via client.ts)
VITE_API_URL=http://localhost/hrdemo/api

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=muwasco
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT Configuration
JWT_SECRET=
# Access token lifetime in seconds. 28800 = 8 hours, i.e. a full working day:
# the SPA renews it silently in the background, so a user is only ever asked
# to sign in again once the (much longer) refresh token also lapses.
JWT_ACCESS_TOKEN_EXPIRY=28800
# Refresh token lifetime in seconds. 2592000 = 30 days, so an employee is not
# signed out over a weekend. The value is read from the refresh_token cookie,
# which is what /auth/renew uses when the access token has already expired.
JWT_REFRESH_TOKEN_EXPIRY=2592000
JWT_ISSUER=muwasco-hr-system

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Security Configuration
BCRYPT_ROUNDS=12
CSRF_EXPIRY=7200
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=900

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@muwasco.co.ke
MAIL_FROM_NAME="MUWASCO HR System"
# Abort an SMTP attempt after N seconds (CLI workers have no max_execution_time)
MAIL_TIMEOUT=20

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage Configuration
STORAGE_PATH=backend/storage
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ---- Encrypted file storage (at rest) ----
# Every file under backend/storage and backend/public/uploads is encrypted with
# AES-256-GCM. A copied folder, a stolen backup or a database dump is unreadable
# without this key.
#
# Generate:  php -r "echo bin2hex(random_bytes(32));"
# MUST be at least 32 characters. MUST NOT equal JWT_SECRET.
# MUST NOT live inside the repository or the web root - put it in the
# environment file outside both (see .env.production.example).
#
# WARNING - LOSING THIS KEY LOSES EVERY STORED FILE, PERMANENTLY. There is no
# recovery path and no reset. Keep an offline (printed / offline-encrypted)
# copy in a separate physical location, and never in the same place as the
# backups it protects.
STORAGE_ENCRYPTION_KEY=
# Bumped by scripts/storage/rotate_master_key.php during a rotation. Leave at 1
# unless you are rotating; the rotation script manages this value.
STORAGE_ENCRYPTION_KEY_VERSION=1
# Set ONLY while a rotation is in flight: the outgoing key, so files not yet
# re-wrapped remain readable. Clear it once the rotation reports 0 remaining.
STORAGE_ENCRYPTION_KEY_PREVIOUS=

# Backup Configuration
BACKUP_PATH=backend/storage/backups
BACKUP_RETENTION_DAYS=30
BACKUP_DB_ENABLED=true
BACKUP_FILES_ENABLED=true

# Monitoring
SENTRY_DSN=
ERROR_LOG_PATH=backend/storage/logs
LOG_LEVEL=debug

# Feature Flags
FEATURE_NEW_ATTENDANCE=false
FEATURE_NEW_PAYROLL=false
FEATURE_NEW_COMPLAINTS=false
FEATURE_MFA=false
FEATURE_CAPTCHA=false
# ---- Attendance Notification System ----
APP_TIMEZONE=Africa/Nairobi

# ---- Seeding (temporary dev credentials Ã¢â‚¬â€ CHANGE in production) ----
SEED_ADMIN_PASSWORD=
SEED_HR_PASSWORD=
SEED_EMP_PASSWORD=
SEED_DEPT_PASSWORD=
SEED_TEST_PASSWORD=
APP_ORGANIZATION_NAME="MUWASCO"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hr@muwasco.co.ke
SMS_PROVIDER=httpsms
HTTPSMS_BASE_URL=https://api.httpsms.com
HTTPSMS_API_KEY=
HTTPSMS_SENDER_PHONE=0112554479
PHONE_DEFAULT_COUNTRY_CODE=254
ATTENDANCE_REMINDER_TIME=08:00
ATTENDANCE_PUSH_REMINDER_ENABLED=true
ATTENDANCE_SMS_REMINDER_ENABLED=true
ATTENDANCE_SMS_FALLBACK_ENABLED=true
ATTENDANCE_SMS_FALLBACK_DELAY_MINUTES=15
ATTENDANCE_SMS_POLICY=fallback
ATTENDANCE_SECOND_REMINDER_ENABLED=false
ATTENDANCE_MAX_SMS_PER_DAY=2
ATTENDANCE_MAX_SMS_ATTEMPTS=3
ATTENDANCE_REMINDERS_MANDATORY=false

# Location is MANDATORY - org requires a verified GPS/Wi-Fi fix inside the office geofence
ATTENDANCE_ALLOW_UNVERIFIED_LOCATION=false

# =============================================================================
# AI Assistance Layer (Phase 3/6 - provider-independent)
# =============================================================================
# Active driver: nvidia_nim = FREE NVIDIA-hosted model (build.nvidia.com free
# credits). Server-side only - it is never exposed to the React frontend.
# NVIDIA is the sole AI agent for this deployment (no Ollama / local model).
#
# Timeout alignment (do not change one side without the other):
#   frontend CHAT_TIMEOUT_MS (src/api/aiAssistant.js) = 120s
#   backend  AI_NVIDIA_TIMEOUT = 45s per attempt, AI_NVIDIA_MAX_RETRIES = 1
#   -> worst case ~91s (2 attempts + backoff) fits inside the frontend budget,
#      so the backend's honest status (success or error) always reaches the
#      user instead of an opaque client-side abort.
AI_PROVIDER=nvidia_nim

# ---- NVIDIA NIM (OpenAI-compatible hosted) -------------------------------
AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com
AI_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_NVIDIA_API_KEY=
AI_NVIDIA_TIMEOUT=45
AI_NVIDIA_MAX_TOKENS=2048
AI_NVIDIA_MAX_RETRIES=1
# nemotron is a REASONING model: by default it burns ~30-100s of invisible
# chain-of-thought before answering, which was the original cause of the
# "assistant took too long to respond" timeouts. Disable it explicitly.
AI_NVIDIA_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}

# ---- Fallback --------------------------------------------------------------
# Disabled: NVIDIA is the only AI agent (no Ollama / local model behind it).
AI_FALLBACK_ENABLED=false

# ---- Global guards ---------------------------------------------------------
AI_MAX_REQUEST_CHARS=4000
AI_MAX_RESPONSE_CHARS=8000
AI_MAX_HISTORY_MESSAGES=20
AI_TEMPERATURE=0.2
