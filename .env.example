# Application Configuration
APP_NAME="MUWASCO HR System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/hrdemo

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=admin_hrdemo
DB_USERNAME=muwascohr
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT Configuration
# REQUIRED: authentication will REFUSE to run with a missing or predictable secret.
# Generate a unique value per environment, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800
JWT_ISSUER=muwasco-hr-system

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Security Configuration
BCRYPT_ROUNDS=12
CSRF_EXPIRY=7200
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=900

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@muwasco.co.ke
MAIL_FROM_NAME="MUWASCO HR System"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Storage Configuration
STORAGE_PATH=backend/storage
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# Backup Configuration
BACKUP_PATH=backend/storage/backups
BACKUP_RETENTION_DAYS=30
BACKUP_DB_ENABLED=true
BACKUP_FILES_ENABLED=true

# Monitoring
SENTRY_DSN=
ERROR_LOG_PATH=backend/storage/logs
LOG_LEVEL=debug

# Feature Flags
FEATURE_NEW_ATTENDANCE=false
FEATURE_NEW_PAYROLL=false
FEATURE_NEW_COMPLAINTS=false
FEATURE_MFA=false
FEATURE_CAPTCHA=false

# Attendance: LOCATION IS MANDATORY. A verified GPS/Wi-Fi fix inside the
# office geofence is required to clock in/out (no "continue without
# location"). Employees are shown their measured distance and the allowed
# radius when outside. Keep this false to enforce on every device.
ATTENDANCE_ALLOW_UNVERIFIED_LOCATION=false
# ---- Attendance Notification System ----
APP_TIMEZONE=Africa/Nairobi
APP_ORGANIZATION_NAME="MUWASCO"

# Web Push (VAPID). Generate: see docs/NOTIFICATIONS.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hr@muwasco.co.ke

# SMS provider: httpsms (Android phone gateway, https://httpsms.com)
SMS_PROVIDER=httpsms
HTTPSMS_BASE_URL=https://api.httpsms.com
HTTPSMS_API_KEY=
HTTPSMS_SENDER_PHONE=
PHONE_DEFAULT_COUNTRY_CODE=254

# Reminder policy (conservative defaults)
ATTENDANCE_REMINDER_TIME=08:00
ATTENDANCE_PUSH_REMINDER_ENABLED=true
ATTENDANCE_SMS_REMINDER_ENABLED=true
ATTENDANCE_SMS_FALLBACK_ENABLED=true
ATTENDANCE_SMS_FALLBACK_DELAY_MINUTES=15
ATTENDANCE_SMS_POLICY=fallback
ATTENDANCE_SECOND_REMINDER_ENABLED=false
ATTENDANCE_SECOND_REMINDER_MINUTES=120
ATTENDANCE_MAX_SMS_PER_DAY=2
ATTENDANCE_MAX_SMS_ATTEMPTS=3
ATTENDANCE_REMINDERS_MANDATORY=false

# ---- Phase 5: Attendance domain switches (Services/Attendance) ----
# Block clock-in while the employee has an APPROVED leave application
# covering today (Phase 5 §10). Response: 409 ON_APPROVED_LEAVE.
ATTENDANCE_BLOCK_CLOCKIN_ON_LEAVE=true
# Late-arrival cutoff for clock-in status (Africa/Nairobi, HH:MM).
# Employees clocking in strictly AFTER this time are marked 'late'.
ATTENDANCE_LATE_CUTOFF=08:30
