<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.5/phpunit.xsd"
         bootstrap="backend/bootstrap.php"
         colors="true"
         cacheResultFile="backend/storage/cache/.phpunit.cache"
         failOnRisky="false"
         failOnWarning="false"
         verbose="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>backend/tests/Unit</directory>
            <!-- Standalone script-style test (run directly with php);
                 it self-executes and exits, which would abort the suite. -->
            <exclude>backend/tests/Unit/Services/AttendanceStatusResolutionTest.php</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>backend/tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <!-- DB-bound tests run in development against a live schema and are
             excluded from the default CI run (no schema is provisioned). -->
        <exclude>
            <group>requires-db</group>
        </exclude>
    </groups>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
    </php>
</phpunit>