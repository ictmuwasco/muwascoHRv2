# ── Environment & Configuration ────────────────────────────────────────────
# `.env` holds real secrets and is NEVER committed. `.env.*` is ignored by
# default so no per-environment variant (`.env.local`, `.env.production`,
# `.env.staging`, ...) can leak by accident; the two name-only templates are
# re-included explicitly below.
#
# The templates MUST contain variable names and non-secret defaults only. A
# real credential in a tracked template is a permanent leak - it is why this
# file is force-purged from history, not just deleted. The blocking CI gate
# `php scripts/ci/secret_scan.php` enforces this on every push.
.env
.env.*
!.env.example
!.env.production.example
config.php
*.local.php

# ── Keys, certificates and credential stores ───────────────────────────────
# Never commit key material, even test/dev keys.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
secrets.json
service-account*.json
gcloud-service-key*.json
.netrc
.npmrc
.dockerenv
*.token

# ── Database ────────────────────────────────────────────────────────────────
# Baseline/backup dumps are NEVER version-controlled - they contain the entire
# production dataset including payroll and national IDs.
*.sql
*.sql.gz
*.sql.zip
*.db
*.sqlite
muwasco (1).sql

# Schema migrations ARE version-controlled (schema-as-code). Without this
# negation every migration is invisible to `git add`, and a deploy that pulls
# from git would silently ship an OLD schema - the new migrations would simply
# never reach the server.
#
# Scoped to the migrations directory on purpose: the blanket `*.sql` rule above
# must still apply everywhere else, so a stray dump dropped at the repo root or
# in backend/storage/backups/ cannot be committed by accident.
!backend/database/migrations/
!backend/database/migrations/*.sql

# ── Build artefacts ──────────────────────────────────────────────────────────
# The Vite bundle is a BUILD OUTPUT, not source. It is regenerated by
# `npm run build` in CI and written to backend/public (see
# frontend/vite.config.js).
#
# These were previously committed, which is actively harmful: a stale
# index.html kept referencing an old bundle hash, so a deploy could ship a
# shell pointing at assets that did not exist - the application would load to
# a blank page with no error. The build now owns this directory.
backend/public/index.html

# Only the fingerprinted bundles are ignored, by CONTENT PATTERN rather than by
# excluding backend/public/assets/ wholesale.
#
# Excluding the directory itself does NOT work: git never descends into an
# excluded directory, so a later negation for assets/.htaccess could never
# re-include it, and the immutable-cache configuration would silently vanish
# from the repository. Ignoring "assets/*" and then re-including the dotfile
# keeps the directory itself visible to git.
backend/public/assets/*
# Re-include the caching rules - they are configuration, not build output.
!backend/public/assets/.htaccess

# Runtime uploads (employee documents, profile images) are user data, not
# source. They are already tracked from before, and .htaccess needs to remain
# version-controlled. Everything else under uploads/ is user content that must
# never be committed.

# ── Dependencies ───────────────────────────────────────────────────────────
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build & Cache ───────────────────────────────────────────────────────────
/dist
frontend/dist/
/build
.cache
*.cache
*.log
temp/
tmp/

# ── IDE & Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Uploads (user content) ──────────────────────────────────────────────────
uploads/*
!uploads/.gitkeep

# ── Diagnostic / scratch scripts (generated during development/probing) ──────
dump.js
probe*.php
probe_out.txt
facts*.txt
gather.ps1

# Local data exports (employee names/IDs) emitted by repair tooling.
# Operational data, not source - never commit.
tools/*-backup.json
profile-image-backup.json

# ── Runtime uploads (user content) ───────────────────────────────────────────
backend/app/public/uploads/
backend/storage/uploads/
backend/storage/policies/*
!backend/storage/policies/.gitkeep
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep

# ── Archives & Backups ───────────────────────────────────────────────────────
*.zip
*.tar
*.gz
*.rar
hrdemo.zip
hrmuwasco.zip

# ── Composer ────────────────────────────────────────────────────────────────
# composer.lock IS committed: deterministic CI/production installs
# (regenerate deliberately via `composer update`; see Phase 5 report §10)

# ── PHPUnit ─────────────────────────────────────────────────────────────────
.phpunit.result.cache
# phpunit.xml is the local dev override (gitignored); phpunit.xml.dist is tracked.
phpunit.xml

# ── OS Files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
$WinREAgent/
$RECYCLE.BIN/
System Volume Information/
# Runtime security counters (rate limiting buckets)
backend/storage/cache/rate-limits/

# Resumable-migration state for encrypt_existing_files.php.
# This records WHICH files are already done, so committing it would carry one
# machine's progress into another checkout and make the migration skip files
# the next developer has never encrypted. Runtime state, never source.
backend/storage/cache/storage_encryption_state.json

# E2E / scratch probe artifacts (never commit runtime outputs)
backend/storage/*.out
backend/storage/*.err
backend/tests/_phpunit_out.txt
backend/tests/_suite_out.txt
# PHPUnit output captured by the CI job and uploaded as a run artifact.
backend/phpunit_output.log
