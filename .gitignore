# ── Environment & Configuration ────────────────────────────────────────────
# `.env` holds real secrets and is NEVER committed. `.env.*` is ignored by
# default so no per-environment variant (`.env.local`, `.env.production`,
# `.env.staging`, ...) can leak by accident; the two name-only templates are
# re-included explicitly below.
#
# The templates MUST contain variable names and non-secret defaults only. A
# real credential in a tracked template is a permanent leak - it is why this
# file is force-purged from history, not just deleted. The blocking CI gate
# `php scripts/ci/secret_scan.php` enforces this on every push.
.env
.env.*
!.env.example
!.env.production.example
config.php
*.local.php

# ── Keys, certificates and credential stores ───────────────────────────────
# Never commit key material, even test/dev keys.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
secrets.json
service-account*.json
gcloud-service-key*.json
.netrc
.npmrc
.dockerenv
*.token

# ── Database ────────────────────────────────────────────────────────────────
*.sql
*.sql.gz
*.sql.zip
*.db
*.sqlite
muwasco (1).sql
# Schema migrations ARE version-controlled (schema-as-code)
!backend/database/migrations/*.sql

# ── Dependencies ───────────────────────────────────────────────────────────
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build & Cache ───────────────────────────────────────────────────────────
/dist
frontend/dist/
/build
.cache
*.cache
*.log
temp/
tmp/

# ── IDE & Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Uploads (user content) ──────────────────────────────────────────────────
uploads/*
!uploads/.gitkeep

# ── Diagnostic / scratch scripts (generated during development/probing) ──────
dump.js
probe*.php
probe_out.txt
facts*.txt
gather.ps1

# ── Runtime uploads (user content) ───────────────────────────────────────────
backend/app/public/uploads/
backend/storage/uploads/
backend/storage/policies/*
!backend/storage/policies/.gitkeep
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep

# ── Archives & Backups ───────────────────────────────────────────────────────
*.zip
*.tar
*.gz
*.rar
hrdemo.zip
hrmuwasco.zip

# ── Composer ────────────────────────────────────────────────────────────────
# composer.lock IS committed: deterministic CI/production installs
# (regenerate deliberately via `composer update`; see Phase 5 report §10)

# ── PHPUnit ─────────────────────────────────────────────────────────────────
.phpunit.result.cache
# phpunit.xml is the local dev override (gitignored); phpunit.xml.dist is tracked.
phpunit.xml

# ── OS Files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
$WinREAgent/
$RECYCLE.BIN/
System Volume Information/
# Runtime security counters (rate limiting buckets)
backend/storage/cache/rate-limits/

# E2E / scratch probe artifacts (never commit runtime outputs)
backend/storage/*.out
backend/storage/*.err
backend/tests/_phpunit_out.txt
backend/tests/_suite_out.txt
