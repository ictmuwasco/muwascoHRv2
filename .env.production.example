# PRODUCTION ENVIRONMENT TEMPLATE (Phase 7, P7-5)
#
# Copy this file on the production host and fill in real values - but NOT as
# `<repo>/.env`.
#
# DO NOT put real values in THIS file. It is git-TRACKED, so a value pasted
# here is committed permanently. That is how production DB, SMTP and AI
# credentials leaked into history once already. Keep this file as the
# name-only template; it must stay credential-free for the secret-scan gate.
#
# WHERE THE LIVE VALUES GO - in order of preference:
#
#   1. Plesk / Apache environment variables (Web Server Settings ->
#      Environment Variables). No file on disk at all.
#   2. A file OUTSIDE both the repository and the web root:
#          mkdir -p /var/www/private
#          nano /var/www/private/hrdemo.env      # paste the real values
#          chown root:httpdata /var/www/private/hrdemo.env
#          chmod 640 /var/www/private/hrdemo.env
#      backend/bootstrap.php loads /var/www/private/hrdemo.env automatically.
#      For any other path, set ENV_FILE (Apache `SetEnv ENV_FILE /path`).
#
# Resolution order in bootstrap.php: $ENV_FILE, then
# /var/www/private/hrdemo.env, then <repo>/.env (local dev only).
#
# NEVER mode 644 - the file holds DB, SMTP and AI credentials.
# After deploying, run: php scripts/ci/secret_scan.php  (must pass)
# =============================================================================

# Application Configuration
APP_NAME="MUWASCO HR System"
# Hard production: APP_DEBUG must be false and APP_ENV=production.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.muwascoerp.co.ke

# Frontend API Configuration (used by the built SPA via frontend/src/config)
VITE_API_URL=https://app.muwascoerp.co.ke/api
# Approved browser origins that may call the API with credentials.
# Comma-separated, NO trailing slash, scheme included.
#
# THE SPA AND THE API SHARE AN ORIGIN HERE (same scheme + host + port), so the
# browser sends same-origin requests and CORS is not exercised at all. This
# value is still required because SecurityMiddleware and the CSRF origin guard
# read it: CSRF_ORIGIN_ENFORCE=true rejects any state-changing request (login,
# logout, every write) whose Origin is not listed here. Setting this to a
# different host than the one serving the page breaks login with a 403.
CORS_ALLOWED_ORIGINS=https://app.muwascoerp.co.ke
# CSRF Origin/Referer enforcement for state-changing requests (Phase 7).
# Keep true unless the deployment binds the API to a non-standard split
# origin; see backend/docs/security/API_SECURITY.md.
CSRF_ORIGIN_ENFORCE=true
# Reverse proxies/LBs allowed to forward X-Forwarded-Proto/For (HTTPS,
# secure cookies). Comma-separated IPs or CIDR blocks of your proxy fleet.
TRUSTED_PROXIES=

# Database Configuration (NOT root! dedicated least-privilege MySQL account)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_hrmuwasco
DB_USERNAME=muwascohr
DB_PASSWORD=Jmwkah198
DB_CHARSET=utf8mb4

# JWT Configuration
# REQUIRED and MUST be unique per environment (at least 32 bytes random):
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=fc7cf573b04f33d778fb2d5d9ba5dd033b24edac5a2324be54f6aef40b875935
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800
JWT_ISSUER=muwasco-hr-system

# Session Configuration
SESSION_LIFETIME=120
# Secure cookies: cookies only transmitted over HTTPS in production.
SESSION_SECURE_COOKIE=true
# HttpOnly is always on (bootstrap.php). SameSite=Lax blocks cross-site
# sends; the CSRF origin guard (above) is the defense-in-depth layer.
SESSION_SAME_SITE=Lax

# Security Configuration
BCRYPT_ROUNDS=12
CSRF_EXPIRY=7200
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=900

# Mail Configuration (real SMTP credentials, never placeholders)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.muwasco.co.ke
MAIL_PORT=587
MAIL_USERNAME=humanresource@muwasco.co.ke
MAIL_PASSWORD=ovifauyjckrtesbs
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=humanresource@muwasco.co.ke
MAIL_FROM_NAME="MUWASCO HR MANAGEMENT System"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0

# Storage Configuration
STORAGE_PATH=backend/storage
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ---- Encrypted file storage (at rest) - REQUIRED IN PRODUCTION ----
# The application REFUSES TO BOOT with APP_ENV=production unless this key is
# present, at least 32 characters, different from JWT_SECRET, and not still the
# placeholder below. The check is in backend/bootstrap.php (hard fail) and
# App\Config\ConfigValidator.
#
# Generate ONCE per environment:   php -r "echo bin2hex(random_bytes(32));"
#
# WHERE IT GOES - this template is git-TRACKED, so a real value pasted here is a
# permanent leak (that is how production credentials were exposed once already).
# Put the real value in /var/www/private/hrdemo.env (or a Plesk environment
# variable), NOT in this file.
#
# LOSS IS PERMANENT AND TOTAL. Every employee document, leave attachment and
# policy file under backend/storage and backend/public/uploads is encrypted with
# a per-file key wrapped by this master key. Lose it and none of them can be
# recovered by any means - there is no reset and no admin override.
#
# Keep an OFFLINE copy (printed, or in a password manager / offline-encrypted
# archive) in a physically separate location from the backups. Do not store it
# beside the backups it protects: that defeats the purpose of encrypting them.
STORAGE_ENCRYPTION_KEY=eea4e5f3ddcf0d82581322182033e7789b8b20c6bca84aa717a79aea91dbfc40
# Managed by scripts/storage/rotate_master_key.php. Leave at 1 unless rotating.
STORAGE_ENCRYPTION_KEY_VERSION=1

# Backup Configuration
BACKUP_PATH=backend/storage/backups
BACKUP_RETENTION_DAYS=30
BACKUP_DB_ENABLED=true
BACKUP_FILES_ENABLED=true
# ---- Encrypted backups (at rest) - REQUIRED IN PRODUCTION ----
# Every archive written by backend/storage/backups/backup.sh is encrypted.
# A stolen backup, an offsite S3 copy, or a lost laptop is unreadable without
# the key.
#
# Cipher: AES-256-CBC + a detached HMAC-SHA256 over the ciphertext
# (encrypt-then-MAC). NOT GCM - `openssl enc` refuses AEAD ciphers:
#     $ openssl enc -aes-256-gcm ...  ->  enc: AEAD ciphers not supported
# (Files at rest still use real AES-256-GCM, via PHP's openssl extension.)
#
# BACKUP_KEY_FILE MUST BE OUTSIDE BACKUP_PATH. The script aborts if the key
# resolves to a path inside BACKUP_DIR - an archive kept with its own key is
# not encrypted. Put it in /var/www/private/ or a systemd credential:
#     openssl rand -hex 32 > /var/www/private/backup.key
#     chmod 600 /var/www/private/backup.key
#
# The encrypted archive is written as <name>.enc with a <name>.enc.hmac
# alongside. To restore:
#     openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -md sha256 \
#         -pass file:/var/www/private/backup.key -in dump.sql.gz.enc \
#         | gunzip -c | mysql -u muwascohr -p muwasco
#
# LOSING THIS KEY LOSES EVERY BACKUP. Keep an offline copy in a third,
# physically separate location.
BACKUP_ENCRYPTION=1
BACKUP_KEY_FILE=/var/www/private/backup.key
BACKUP_PBKDF2_ITER=200000

# Monitoring — ERROR LOG LEVEL: info or error (never debug in production)
SENTRY_DSN=
ERROR_LOG_PATH=backend/storage/logs
LOG_LEVEL=info

# Feature Flags
FEATURE_NEW_ATTENDANCE=true
FEATURE_NEW_PAYROLL=true
FEATURE_NEW_COMPLAINTS=true
# Strongly recommended before full production rollout (Phase 7 remaining
# risk). Not yet implemented — do NOT enable unless the feature exists.
FEATURE_MFA=false
FEATURE_CAPTCHA=false

