# =============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE (Phase 7, P7-5)
#
# Copy to .env on the production host and fill in real values.
# EVERY value below is the SECURE production posture; dev defaults from
# .env.example must never ship to production unqualified.
#
# NEVER commit this file content to the live .env. `.env` is gitignored.
# After deploying, run: php scripts/ci/secret_scan.php  (must pass)
# =============================================================================

# Application Configuration
APP_NAME="MUWASCO HR System"
# Hard production: APP_DEBUG must be false and APP_ENV=production.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hr.muwasco.co.ke

# Frontend API Configuration (used by the built SPA via frontend/src/config)
VITE_API_URL=https://hr.muwasco.co.ke/api
# Approved browser origins that may call the API with credentials.
# Comma-separated, NO trailing slash, scheme included.
CORS_ALLOWED_ORIGINS=https://hr.muwasco.co.ke
# CSRF Origin/Referer enforcement for state-changing requests (Phase 7).
# Keep true unless the deployment binds the API to a non-standard split
# origin; see backend/docs/security/API_SECURITY.md.
CSRF_ORIGIN_ENFORCE=true
# Reverse proxies/LBs allowed to forward X-Forwarded-Proto/For (HTTPS,
# secure cookies). Comma-separated IPs or CIDR blocks of your proxy fleet.
TRUSTED_PROXIES=

# Database Configuration (NOT root! dedicated least-privilege MySQL account)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=muwasco
DB_USERNAME=muwascohr
DB_PASSWORD=<generate-a-strong-unique-password>
DB_CHARSET=utf8mb4

# JWT Configuration
# REQUIRED and MUST be unique per environment (at least 32 bytes random):
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=<generate-with-the-command-above>
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800
JWT_ISSUER=muwasco-hr-system

# Session Configuration
SESSION_LIFETIME=120
# Secure cookies: cookies only transmitted over HTTPS in production.
SESSION_SECURE_COOKIE=true
# HttpOnly is always on (bootstrap.php). SameSite=Lax blocks cross-site
# sends; the CSRF origin guard (above) is the defense-in-depth layer.
SESSION_SAME_SITE=Lax

# Security Configuration
BCRYPT_ROUNDS=12
CSRF_EXPIRY=7200
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=900

# Mail Configuration (real SMTP credentials, never placeholders)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.muwasco.co.ke
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hr@muwasco.co.ke
MAIL_FROM_NAME="MUWASCO HR System"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0

# Storage Configuration
STORAGE_PATH=backend/storage
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# Backup Configuration
BACKUP_PATH=backend/storage/backups
BACKUP_RETENTION_DAYS=30
BACKUP_DB_ENABLED=true
BACKUP_FILES_ENABLED=true

# Monitoring — ERROR LOG LEVEL: info or error (never debug in production)
SENTRY_DSN=
ERROR_LOG_PATH=backend/storage/logs
LOG_LEVEL=info

# Feature Flags
FEATURE_NEW_ATTENDANCE=true
FEATURE_NEW_PAYROLL=true
FEATURE_NEW_COMPLAINTS=true
# Strongly recommended before full production rollout (Phase 7 remaining
# risk). Not yet implemented — do NOT enable unless the feature exists.
FEATURE_MFA=false
FEATURE_CAPTCHA=false

# Attendance: LOCATION IS MANDATORY (keep false to enforce geofence).
ATTENDANCE_ALLOW_UNVERIFIED_LOCATION=false
# ---- Attendance Notification System ----
APP_TIMEZONE=Africa/Nairobi
APP_ORGANIZATION_NAME="MUWASCO"

# Web Push (VAPID) — unique per environment
VAPID_PUBLIC_KEY=<generate-per-NOTIFICATIONS.md>
VAPID_PRIVATE_KEY=<generate-per-NOTIFICATIONS.md>
VAPID_SUBJECT=mailto:hr@muwasco.co.ke

# SMS provider: httpsms (Android phone gateway, https://httpsms.com)
SMS_PROVIDER=httpsms
HTTPSMS_BASE_URL=https://api.httpsms.com
HTTPSMS_API_KEY=<httpsms-api-key>
HTTPSMS_SENDER_PHONE=<sender-phone>
PHONE_DEFAULT_COUNTRY_CODE=254

# Reminder policy (conservative defaults)
ATTENDANCE_REMINDER_TIME=08:00
ATTENDANCE_PUSH_REMINDER_ENABLED=true
ATTENDANCE_SMS_REMINDER_ENABLED=true
ATTENDANCE_SMS_FALLBACK_ENABLED=true
ATTENDANCE_SMS_FALLBACK_DELAY_MINUTES=15
ATTENDANCE_SMS_POLICY=fallback
ATTENDANCE_SECOND_REMINDER_ENABLED=false
ATTENDANCE_SECOND_REMINDER_MINUTES=120
ATTENDANCE_MAX_SMS_PER_DAY=2
ATTENDANCE_MAX_SMS_ATTEMPTS=3
ATTENDANCE_REMINDERS_MANDATORY=false

# ---- Phase 5: Attendance domain switches (Services/Attendance) ----
ATTENDANCE_BLOCK_CLOCKIN_ON_LEAVE=true
ATTENDANCE_LATE_CUTOFF=08:30