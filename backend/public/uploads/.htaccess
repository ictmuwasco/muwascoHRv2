# ===========================================================================
# Uploads storage — NEVER directly web-accessible (Phase 7, findings P7-1/P7-2)
#
# This tree holds HR documents (employee profile documents, leave
# attachments). Files must only ever be delivered through the authorized
# API endpoints, which verify authentication and ownership/permission
# before streaming bytes, e.g.:
#
#   GET /api/profile/documents/{id}          (EmployeeController)
#   GET /api/leave/applications/{id}/documents/{documentId}  (LeaveController)
#
# Legacy files stored here by the retired unvalidated upload action are
# served through the same authorized streaming endpoint (legacy-path
# fallback) — direct URL access is denied below, which also prevents
# any uploaded file from being fetched without authorization or executed.
# ===========================================================================

# 1. Deny all direct HTTP access to this tree.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# 2. Defense in depth: even if the access rules above are ever relaxed,
#    never execute anything stored here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Options -ExecCGI -Indexes

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .asp .aspx .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .asp .aspx .sh
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .asp .aspx .sh
AddHandler default-handler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py
