<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ===========================================================================
# File/extension deny rules
#
# WHY DUPLICATED HERE
#   When Apache's DocumentRoot points at backend/public, the repository-root
#   .htaccess is NOT read. The root file's path rules deliberately exempt
#   backend/public/ (`backend/(?!public/)`), so in that layout those rules are
#   skipped entirely and this file was the ONLY thing standing between a
#   visitor and whatever sits in the web root.
#
#   The root .htaccess rules are path-based (deny whole trees). These are
#   extension-based, which is a genuinely different axis: the live server was
#   observed returning 403 for /.env and /foo.sql while /x.env and /bar.md
#   fell through to the PHP front controller (302 -> login.php). Extension
#   matching alone therefore does NOT protect files whose names do not end in
#   a denied extension. Denying both here keeps the two layouts equivalent.
#
#   404 rather than 403 would avoid confirming existence, but 403 is kept to
#   match the already-shipped root .htaccess behaviour.
# ===========================================================================
<IfModule mod_authz_core.c>
    # Deny all dotfiles and their directories (.env, .git, .htpasswd, ...).
    # FilesMatch alone cannot match a leading-dot NAME, so this is separate.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    <FilesMatch "\.(env|log|sql|md|lock|ya?ml|sh|bat|ps1|ini|toml|ts|tsx|jsx|bak|backup|orig|swp|save)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(env|log|sql|md|lock|ya?ml|sh|bat|ps1|ini|toml|ts|tsx|jsx|bak|backup|orig|swp|save)$">
        Deny from all
    </FilesMatch>
</IfModule>

# Never serve a directory listing. Also stops the uploader probe from
# enumerating uploads/employee_documents/ or uploads/profile_images/.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ===========================================================================
# Asset delivery (performance)
#
# This file is the complete web configuration when Apache's DocumentRoot points
# directly at backend/public (rather than at the repository root with the app
# under /hrdemo). In that layout the repository-root .htaccess is NOT read, so
# the compression and cache rules are duplicated here. Directives are additive
# and idempotent, so having both files active is harmless.
# ===========================================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # The SPA shell names the current hashed bundle: revalidate it always.
    # (Vite's fingerprinted files under /assets get a one-year immutable
    # lifetime from assets/.htaccess.)
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(woff2?|ttf|png|jpe?g|gif|svg|webp|ico|avif)$">
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
