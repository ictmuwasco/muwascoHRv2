<?xml version="1.0" encoding="UTF-8"?>
<!--
    Canonical PHPUnit configuration. This file is tracked in git.

    There is also a gitignored backend/phpunit.xml, which is the local
    developer override. The .gitignore comment claimed phpunit.xml.dist was
    the tracked file, but no .dist file had ever been committed - so on CI the
    config lookup in deploy.yml fell through every candidate path and PHPUnit
    had no configuration at all. Combined with zero test files, that is why the
    suite reported success while running nothing.

    PATH RESOLUTION - READ THIS BEFORE "FIXING" IT AGAIN.
    PHPUnit 9 resolves `bootstrap` relative to the DIRECTORY CONTAINING THIS
    CONFIG FILE, not the process working directory. Since this file lives in
    backend/, "tests/bootstrap.php" already resolves to
    backend/tests/bootstrap.php, from any working directory.

    That is why the suite ran fine locally. The CI failure was NOT a path
    problem - it was a blank DB_PASSWORD (see deploy.yml). Do not add a
    `backend/` prefix here: doing so resolves to backend/backend/... and the
    run dies with "Cannot open file backend\backend/tests/bootstrap.php",
    which was verified by actually running it.

    The <directory> elements below are relative to this same directory, which
    is why "tests/Unit" and "tests/Integration" are correct as written.
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    verbose="true"
    stopOnFailure="false"
    failOnWarning="false"
    failOnRisky="false"
>
    <testsuites>
        <testsuite name="Unit Tests">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration Tests">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
        <!--
            A suite is declared here only alongside the directory it names.

            The previous configuration pointed at tests/Unit/Services,
            tests/Unit/Repositories and tests/Unit/Controllers, none of which
            ever existed. PHPUnit aborts the entire run when a declared
            directory is missing, so a phantom suite is worse than no suite -
            it looks configured while running nothing.
        -->
    </testsuites>
</phpunit>
