# =============================================================================
# MUWASCO HR Frontend — Environment Configuration
# =============================================================================
# Vite automatically exposes any variable prefixed with VITE_ to the client
# bundle at build time. These are compile-time constants; they are NOT
# evaluated at runtime, so changing them requires a rebuild.
#
# Copy this file to ".env" and adjust for each environment:
#   cp .env.example .env
# =============================================================================

# --- API base URL ------------------------------------------------------------
# Used by the centralized Axios client (src/api/client.ts) and re-exported
# for any component that needs to build a direct URL (e.g. avatar images).
#
# Development: Vite's dev-server proxy (vite.config.js) forwards /api/* to the
#   XAMPP Apache server at http://localhost/hrdemo/api/*. Setting this to
#   "/api" lets the proxy handle the rewrite transparently.
#
# Production: If the app is served from a sub-path or CDN, set the full URL:
#   VITE_API_URL=https://hr.muwasco.co.ke/hrdemo
#
# If unset, the client defaults to "/api".
VITE_API_URL=/api

# --- Application version (for error reporting / debugging) ------------------
# Shipped in client-error reports so support can correlate with a deployment.
VITE_APP_VERSION=1.0.0

# --- Feature flags (optional) -----------------------------------------------
# VITE_ENABLE_PWA=1          Enable Progressive Web App features
# VITE_ENABLE_DEBUG=1        Show verbose client-side logs
# VITE_SENTRY_DSN=            Sentry DSN if migrating from custom error reporting
