{
  "name": "muwasco/hr-system",
  "description": "Murang'a Water and Sanitation Company - HR Management System",
  "type": "project",
  "require": {
    "php": ">=8.0",
   "firebase/php-jwt": "^6.11.1",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.9",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.11",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.0.30"
    },
    "secure-http": true,
    "optimize-autoloader": true,
    "platform-check": false
  },
  "autoload": {
    "psr-4": {
      "App\\": "backend/app/",
      "Database\\": "backend/database/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "backend/tests/"
    }
  },
  "scripts": {
    "migrate": "php backend/database/migrate.php",
    "seed": "php backend/database/seed.php",
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 backend/app",
    "analyze": "phpstan analyse backend/app --level=6"
  }
}
